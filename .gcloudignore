# Files NOT uploaded to Cloud Build.
# Patterns are gitignore-style — anchor with leading / to match only repo root,
# otherwise they match recursively (e.g. "supabase/" would also exclude
# backend/app/core/supabase/).

/.git/
.gitignore
.env
.env.*
/.claude/
/.vscode/

# Frontend (deployed by Vercel, not Cloud Run)
/frontend/

# Repo-root only — backend/* with same names must NOT be excluded
/_archive/
/docs/
/assets/
/bin/
# Exclude the directory's CONTENTS rather than the directory, so the one file
# the build itself needs can be negated back in. Excluding `/scripts/` outright
# makes the negation impossible (gitignore cannot re-include a path under an
# excluded directory) — which is how `make deploy-backend` came to fail with
# "can't open file '/workspace/scripts/check_ci_status.py'". Trigger builds
# fetch from git and ignore this file, so only the manual path was broken.
/scripts/*
!/scripts/check_ci_status.py
/supabase/
/etc/

# Python local — recursive OK
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
backend/.venv/
backend/data/
backend/.coverage

# Tests, notebooks, raw data — not needed to build/run the API.
# These were ~291M of the ~298M build context (backend/tests 197M, /data 94M).
backend/tests/
backend/notebooks/
/notebooks/
/data/
*.zip

# Compose / mac
docker-compose.yml
.DS_Store
LICENSE
README.md
vercel.json
